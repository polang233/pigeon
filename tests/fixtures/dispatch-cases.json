{
  "说明": "分派规则怎么判的共用用例。网页（web/src/core/route.js 的 routeOf）和应用（POST /api/dispatch/suggest）都要跑过。判法见 docs/CONTRACT.md 的“分派规则的建议”。expect 里 rule、suggested 为空串表示没有规则命中；kind 只在给了 to 时比较。",
  "low": 20,
  "rules": [
    { "id": "r1", "when": "生图、改图", "kw": "图 画 icon logo", "to": "codex@local", "fb": "", "ask": false, "on": true },
    { "id": "r2", "when": "代码审查", "kw": "审、review，看看对不对", "to": "codex@local", "fb": "claude@local", "ask": false, "on": true },
    { "id": "r3", "when": "要在 Windows 上跑的", "kw": "windows win exe msvc", "to": "codex@win", "fb": "codex@local", "ask": false, "on": true },
    { "id": "r4", "when": "关着的规则", "kw": "翻译", "to": "codex@local", "fb": "", "ask": false, "on": false },
    { "id": "r5", "when": "交给的那家不在了", "kw": "批量", "to": "deepseek@local", "fb": "", "ask": false, "on": true },
    { "id": "r6", "when": "没写关键词", "kw": "", "to": "codex@local", "fb": "", "ask": false, "on": true },
    { "id": "r7", "when": "规则自己写了要问", "kw": "发布 release", "to": "codex@local", "fb": "", "ask": true, "on": true },
    { "id": "r8", "when": "批量的活，排在后面的那条", "kw": "批量 重命名", "to": "codex@local", "fb": "", "ask": false, "on": true }
  ],
  "cases": [
    { "name": "第一条命中", "text": "画一个应用图标", "alive": ["codex@local", "claude@local", "codex@win"], "quota": { "codex@local": 60 }, "confirmRemote": true,
      "expect": { "rule": "r1", "suggested": "codex@local", "fb": false, "ask": false } },
    { "name": "不分大小写", "text": "换一个 LOGO", "alive": ["codex@local"], "quota": {}, "confirmRemote": true,
      "expect": { "rule": "r1", "suggested": "codex@local", "fb": false, "ask": false } },
    { "name": "关键词用顿号和逗号分开也行", "text": "帮我 Review 一下这段", "alive": ["codex@local", "claude@local"], "quota": { "codex@local": 60 }, "confirmRemote": true,
      "expect": { "rule": "r2", "suggested": "codex@local", "fb": false, "ask": false } },
    { "name": "额度不够改派", "text": "审一下确认框的改动", "alive": ["codex@local", "claude@local"], "quota": { "codex@local": 16 }, "confirmRemote": true,
      "expect": { "rule": "r2", "suggested": "claude@local", "fb": true, "ask": false } },
    { "name": "额度刚好等于阈值不算不够", "text": "审一下", "alive": ["codex@local", "claude@local"], "quota": { "codex@local": 20 }, "confirmRemote": true,
      "expect": { "rule": "r2", "suggested": "codex@local", "fb": false, "ask": false } },
    { "name": "额度不够但没写改派，照常派", "text": "画一张海报图", "alive": ["codex@local"], "quota": { "codex@local": 5 }, "confirmRemote": true,
      "expect": { "rule": "r1", "suggested": "codex@local", "fb": false, "ask": false } },
    { "name": "额度不够但改派的那家不在了，照常派", "text": "审一下", "alive": ["codex@local"], "quota": { "codex@local": 5 }, "confirmRemote": true,
      "expect": { "rule": "r2", "suggested": "codex@local", "fb": false, "ask": false } },
    { "name": "没有额度数字的不算不够", "text": "审一下", "alive": ["codex@local", "claude@local"], "quota": {}, "confirmRemote": true,
      "expect": { "rule": "r2", "suggested": "codex@local", "fb": false, "ask": false } },
    { "name": "交给别的电脑要问", "text": "在 windows 上跑测试", "alive": ["codex@local", "codex@win"], "quota": {}, "confirmRemote": true,
      "expect": { "rule": "r3", "suggested": "codex@win", "fb": false, "ask": true } },
    { "name": "跨设备确认关掉了就不问", "text": "在 windows 上跑测试", "alive": ["codex@local", "codex@win"], "quota": {}, "confirmRemote": false,
      "expect": { "rule": "r3", "suggested": "codex@win", "fb": false, "ask": false } },
    { "name": "额度不够改派回本机就不用问", "text": "打个 exe", "alive": ["codex@local", "codex@win"], "quota": { "codex@win": 3 }, "confirmRemote": true,
      "expect": { "rule": "r3", "suggested": "codex@local", "fb": true, "ask": false } },
    { "name": "那台不在了，跳过这条，后面也没命中", "text": "在 windows 上跑测试", "alive": ["codex@local"], "quota": {}, "confirmRemote": true,
      "expect": { "rule": "", "suggested": "", "fb": false, "ask": false } },
    { "name": "关着的规则不算", "text": "把文档翻译成英文", "alive": ["codex@local"], "quota": {}, "confirmRemote": true,
      "expect": { "rule": "", "suggested": "", "fb": false, "ask": false } },
    { "name": "交给的不在了就往下看，落到后面那条", "text": "批量改文件名", "alive": ["codex@local"], "quota": {}, "confirmRemote": true,
      "expect": { "rule": "r8", "suggested": "codex@local", "fb": false, "ask": false } },
    { "name": "规则自己写了要问", "text": "发布 0.2.0", "alive": ["codex@local"], "quota": {}, "confirmRemote": false,
      "expect": { "rule": "r7", "suggested": "codex@local", "fb": false, "ask": true } },
    { "name": "什么都没命中", "text": "解释一下这个函数", "alive": ["codex@local"], "quota": {}, "confirmRemote": true,
      "expect": { "rule": "", "suggested": "", "fb": false, "ask": false } },
    { "name": "照规则派：kind 是 rule", "text": "画一个图标", "to": "codex@local", "alive": ["codex@local", "claude@local"], "quota": {}, "confirmRemote": true,
      "expect": { "rule": "r1", "suggested": "codex@local", "fb": false, "ask": false, "kind": "rule" } },
    { "name": "照改派的派：kind 是 quota", "text": "审一下", "to": "claude@local", "alive": ["codex@local", "claude@local"], "quota": { "codex@local": 3 }, "confirmRemote": true,
      "expect": { "rule": "r2", "suggested": "claude@local", "fb": true, "ask": false, "kind": "quota" } },
    { "name": "没照建议派：kind 是 override", "text": "画一个图标", "to": "codex@win", "alive": ["codex@local", "codex@win"], "quota": {}, "confirmRemote": true,
      "expect": { "rule": "r1", "suggested": "codex@local", "fb": false, "ask": false, "kind": "override" } },
    { "name": "没有规则命中：kind 是 lead", "text": "解释一下这个函数", "to": "codex@local", "alive": ["codex@local"], "quota": {}, "confirmRemote": true,
      "expect": { "rule": "", "suggested": "", "fb": false, "ask": false, "kind": "lead" } }
  ]
}
